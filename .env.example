# Copy to .env next to docker-compose.yml and fill in.
# Generate secrets with: openssl rand -hex 32
# (hex keeps them safe inside the DATABASE_URL.)

# Host folder for Postgres data and uploaded photos.
DEFIB_DATA_DIR=/srv/clearmesh-defib

POSTGRES_PASSWORD=

# --- Auth.js -----------------------------------------------------------------
AUTH_URL=https://aed.clearmesh.app
AUTH_SECRET=
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Authorised redirect URI: https://aed.clearmesh.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google accounts allowed into /admin.
ADMIN_EMAILS=jasonfinlen@gmail.com

# Salt for hashing visitor IPs (rate limiting). Changing it resets the limits.
IP_HASH_SALT=

# --- Optional -----------------------------------------------------------------
# what3words: https://developer.what3words.com/ (blank = feature off)
W3W_API_KEY=
# Cloudflare Turnstile anti-spam: dashboard > Turnstile > add site (blank = off)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Contact address sent to Nominatim with lookups (recommended by their policy).
NOMINATIM_EMAIL=

# Abuse limits per visitor IP.
SUBMISSIONS_PER_HOUR=5
SUBMISSIONS_PER_DAY=20
REPORTS_PER_HOUR=10
